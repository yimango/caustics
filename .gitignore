# Build directories
build/
bin/
obj/

# IDE and editor files
.vscode/
.vs/
*.vcxproj*
*.sln
*.suo
*.user
*.swp
*.tmp

# Compiled executables
*.exe
*.out
*.app

# Object files
*.o
*.obj

# Libraries
*.lib
*.a
*.so
*.dylib
*.dll

# CMake generated files
CMakeCache.txt
CMakeFiles/
cmake_install.cmake
Makefile
*.cmake

# Package manager files
vcpkg/
packages/

# Large binary files
*.zip
*.tar.gz
*.7z
*.mkv
*.avi
*.mp4
*.mov

# Documentation and examples (keep only essential files)
**/docs/
**/examples/
**/bin/

# GLFW import libraries under external/glfw-3.4.bin.WIN64/lib-mingw-w64 stay local.
# verify/glfw_link_stubs.c links the wave check. The app links the local .a.
**/lib-*/

# Audit captures. .audit/caustic-contract.md stays tracked.
.audit/*.png
.audit/*.bmp
.audit/*.tsv
.audit/*.err
.audit/*.out

# Logs and temporary files
*.log
*.tmp
*.temp

# System files
.DS_Store
Thumbs.db
*.swp
*~

# Debug files
*.pdb
*.ilk 